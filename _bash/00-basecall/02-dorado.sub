# dorado.sub

# basecall raw nanopore signal on a GPU, one FAST5 chunk per job

log = logs/02-dorado/$(chunk).log
error = logs/02-dorado/$(chunk).err
output = logs/02-dorado/$(chunk).out

executable = 02-dorado.sh
arguments = $(chunk)

batch_name = "dorado"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
requirements = (HasCHTCStaging == true)

## GPU (CHTC GPU Lab); check these against CHTC's current GPU guide:
request_gpus = 1
+WantGPULab = true
+GPUJobLength = "short"
require_gpus = (GlobalMemoryMb >= 16000)

request_cpus = 4
request_memory = 32GB
request_disk = 40GB

## One job per chunk written by 01-split-fast5:
chunk = $Fn(chunk_path)
queue chunk_path matching files /staging/l/lnell/dna/ont/fast5_chunks/chunk_*.tar
