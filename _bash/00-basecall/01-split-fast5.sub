# split-fast5.sub

# split the raw nanopore signal archive into chunks for GPU basecalling

container_image = file:///staging/l/lnell/tany_time.sif

log = logs/01-split-fast5/split-fast5.log
error = logs/01-split-fast5/split-fast5.err
output = logs/01-split-fast5/split-fast5.out

executable = 01-split-fast5.sh

batch_name = "split-fast5"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
requirements = (HasCHTCStaging == true)

request_cpus = 2
request_memory = 4GB
request_disk = 40GB

queue 1
