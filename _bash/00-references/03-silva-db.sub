# silva-db.sub

# build a Kraken2 database from SILVA SSU rRNA (one time)

container_image = file:///staging/l/lnell/tany_time.sif

log = logs/03-silva-db/silva-db.log
error = logs/03-silva-db/silva-db.err
output = logs/03-silva-db/silva-db.out

executable = 03-silva-db.sh

batch_name = "silva-db"

should_transfer_files = YES
transfer_input_files = ../bin
when_to_transfer_output = ON_EXIT
requirements = (HasCHTCStaging == true)

request_cpus = 8
request_memory = 32GB
request_disk = 40GB

queue 1
