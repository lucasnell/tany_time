# hologenome.sub

# build combined reference for competitive mapping

container_image = file:///staging/l/lnell/tany_time.sif

log = logs/02-hologenome/hologenome.log
error = logs/02-hologenome/hologenome.err
output = logs/02-hologenome/hologenome.out

executable = 02-hologenome.sh

batch_name = "hologenome"

should_transfer_files = YES

## COI barcodes (written by `_R/get-mito-refs.R`):
transfer_input_files = ../references/coi-barcodes.fasta
when_to_transfer_output = ON_EXIT
requirements = (HasCHTCStaging == true)

request_cpus = 2
request_memory = 16GB
request_disk = 30GB

queue 1
