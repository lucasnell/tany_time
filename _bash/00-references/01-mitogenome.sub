# mitogenome.sub

# assemble the T. gracilentus mitochondrial genome from nanopore reads

container_image = file:///staging/l/lnell/tany_time.sif

log = logs/01-mitogenome/mitogenome.log
error = logs/01-mitogenome/mitogenome.err
output = logs/01-mitogenome/mitogenome.out

executable = 01-mitogenome.sh

batch_name = "mitogenome"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
requirements = (HasCHTCStaging == true)

## Reference sequences (written by `_R/get-mito-refs.R`):
transfer_input_files = ../references/tgraci-mito-bait.fasta, ../references/tgraci-coi.fasta, ../references/tgraci-mito-features.fasta, ../_apptainer/bin/mito-collapse.sh

request_cpus = 8
request_memory = 32GB
request_disk = 100GB

queue 1
