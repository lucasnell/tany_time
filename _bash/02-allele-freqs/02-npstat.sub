# npstat.sub

# calculate population-genetic parameters for Pool-seq samples

# Window length in kb:
win_kb = 10

container_image = file:///staging/l/lnell/tany_time.sif

log =           logs/02-npstat/$(readbase)_$(win_kb)kb.log
error =         logs/02-npstat/$(readbase)_$(win_kb)kb.err
output =        logs/02-npstat/$(readbase)_$(win_kb)kb.out

executable = 02-npstat.sh
arguments = $(readbase) $(n_adults) $(win_kb)

batch_name =    "npstat"

should_transfer_files =     YES
transfer_input_files = ../bin
when_to_transfer_output =   ON_EXIT
requirements =              (HasCHTCStaging == true)

request_cpus =      16
request_memory =    16GB
# The pileup made from the sync file and its per-contig copies coexist
# while splitting; Blik-19 went over 49 GB (2026-11-02), and other large
# pools reported up to 40 GB.
request_disk =      100GB

queue readbase,n_adults from ../samples/all-pools-n-adults.txt
