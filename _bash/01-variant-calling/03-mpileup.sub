# mpileup.sub

# prep aligned Pool-seq DNA reads and call `samtools mpileup`

container_image = file:///staging/l/lnell/tany_time.sif

log = logs/03-mpileup/$(readbase).log
error = logs/03-mpileup/$(readbase).err
output = logs/03-mpileup/$(readbase).out

executable = 03-mpileup.sh
arguments = $(readbase)

batch_name = "mpileup"

should_transfer_files = YES
transfer_input_files = ../bin
when_to_transfer_output = ON_EXIT
requirements = (HasCHTCStaging == true)

request_cpus = 4
request_memory = 32GB
request_disk = 60GB

queue readbase from ../samples/all-pools.txt
