# kraken.sub

# classify a subsample of unmapped reads per pool (diagnostic)

container_image = file:///staging/lnell/tany_time.sif

log = logs/06b-kraken/kraken.log
error = logs/06b-kraken/kraken.err
output = logs/06b-kraken/kraken.out

executable = 06b-kraken.sh

batch_name = "kraken"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
requirements = (HasCHTCStaging == true)

transfer_input_files = ../samples/all-pools.txt

## Copying outputs to ResearchDrive:
transfer_output_files = kraken.tar
output_destination = pelican://chtc.wisc.edu/researchdrive/arives/CHTC/kraken

request_cpus = 8
request_memory = 24GB
request_disk = 100GB

queue 1
