# abc-sims.sub

# ABC simulations (or observed statistics) for crashes vs. immigration

container_image = file:///staging/l/lnell/tany_time.sif

log = logs/01-abc-sims/$(Variant)-$(Model)-b$(Batch).log
error = logs/01-abc-sims/$(Variant)-$(Model)-b$(Batch).err
output = logs/01-abc-sims/$(Variant)-$(Model)-b$(Batch).out

executable = 01-abc-sims.sh
arguments = $(Variant) $(Model) $(Batch) $(Seed0) $(NSims)

batch_name = "abc-sims"

should_transfer_files = YES
transfer_input_files = ../bin
when_to_transfer_output = ON_EXIT
requirements = (HasCHTCStaging == true)

#' msprime and R are single-threaded. The pilot (2026-11-13) went over
#' 12 GB (last measured 12-14.6 GB) and used up to 4.75 GB disk before
#' `abc-stats.R` was changed to work one pool at a time and drop sites that
#' can't segregate (local peak 4.4 GB at 14 million simulated sites,
#' without poolfstat's F_ST); 20 GB leaves room for F_ST and python.
request_cpus = 1
request_memory = 20GB
request_disk = 12GB

#' `abc_info.txt` (variant,model,batch,seed,n_sims) is written by
#' `_R/make-job-lists.R`.
queue Variant,Model,Batch,Seed0,NSims from abc_info.txt
