
Bootstrap: docker
From: condaforge/miniforge3:26.7.2-0

%files
    helpers.sh /app/helpers.sh
    bin /app/bin
    baypass-env.yml /app/baypass-env.yml
    main-env.yml /app/main-env.yml
    gatk-env.yml /app/gatk-env.yml
    gatk3-env.yml /app/gatk3-env.yml
    qc-env.yml /app/qc-env.yml
    kraken-env.yml /app/kraken-env.yml
    mito-env.yml /app/mito-env.yml

%post -c /bin/bash
    export HOME=/app
    chmod -R 777 /opt/conda && \
        chmod -R 777 /app && \
        chmod -R 777 /tmp
    apt-get clean
    apt-get update -y
    apt-get install -y build-essential
    apt-get install -y locales wget rsync unzip nano sudo ocaml-nox zlib1g-dev \
        libbz2-dev liblzma-dev gsl-bin libgsl0-dev libboost-all-dev pv
    rm -rf /var/lib/apt/lists/*
    locale-gen en_US.UTF-8
    echo "" >> /app/.bashrc && \
        cat /app/helpers.sh >> /app/.bashrc && \
        echo "" >> /app/.bashrc && \
        rm /app/helpers.sh
    # Project scripts (see _bash/_apptainer/README.md):
    chmod 755 /app/bin/*
    conda init bash
    conda config --set solver libmamba
    conda config --set auto_update_conda false
    conda env create -q -f /app/baypass-env.yml && \
        rm /app/baypass-env.yml && \
        conda clean --all -y
    conda env create -q -f /app/main-env.yml && \
        rm /app/main-env.yml && \
        conda clean --all -y
    conda env create -q -f /app/gatk-env.yml && \
        rm /app/gatk-env.yml && \
        conda clean --all -y
    conda env create -q -f /app/gatk3-env.yml && \
        rm /app/gatk3-env.yml && \
        conda clean --all -y
    conda env create -q -f /app/qc-env.yml && \
        rm /app/qc-env.yml && \
        conda clean --all -y
    conda env create -q -f /app/kraken-env.yml && \
        rm /app/kraken-env.yml && \
        conda clean --all -y
    # medaka downloads models at run time; jobs may lack internet, so fetch
    # the model for the nanopore reads (R9.4.1, Dorado 0.9.6 sup v3.6; medaka
    # pairs this model with sup v3.3, none with v3.6) now:
    conda env create -q -f /app/mito-env.yml && \
        rm /app/mito-env.yml && \
        conda run -n mito-env medaka tools download_models \
            --models r941_min_sup_g507 && \
        conda clean --all -y
    # snape-pooled: original repo (EmanueleRaineri/snape-pooled) was deleted;
    # the DEST-bio fork has the same commit.
    cd /opt && \
    	sha="284bfe054da37232d3e23dfbfa6f67bcaa9cf89a" && \
        wget -q https://github.com/DEST-bio/snape-pooled/archive/${sha}.zip && \
    	unzip -q ${sha}.zip && \
        rm ${sha}.zip && \
    	mv snape-pooled-${sha} snape-pooled && \
    	cd snape-pooled && \
    	sed -i 's/Array.create/Array.make/g' pooled.ml && \
    	sed -i 's/String.uppercase/String.uppercase_ascii/g' pooled.ml && \
    	make && \
    	mv snape-pooled /usr/local/bin/ && \
    	cd .. && \
    	rm -r snape-pooled
    cd /opt && \
    	sha="dc230fba3ac434ed6526ab7cd63a67d69d34b7d6" && \
        wget -q https://github.com/lucaferretti/npstat/archive/${sha}.zip && \
    	unzip -q ${sha}.zip && \
        rm ${sha}.zip && \
    	mv npstat-${sha} npstat && \
    	cd npstat && \
    	make && \
    	mv npstat /usr/local/bin/ && \
    	cd .. && \
    	rm -r npstat


%environment
    export LANG=en_US.UTF-8
    export LANGUAGE=en_US:en
    export LC_ALL=en_US.UTF-8
    export TZ=America/New_York
    export HOME=/app
    export PATH=/app/bin:$PATH
    export SINGULARITY_SHELL=/bin/bash

%labels
    Author Lucas Nell
    ContactEmail lucnell@gmail.com
    Name tany_time
    Version v2.4.0
