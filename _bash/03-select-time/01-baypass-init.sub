# baypass-init.sub

# baypass core model to estimate Omega, per missing-data setting and subsample

container_image = file:///staging/l/lnell/tany_time.sif

log = logs/01-baypass-init/$(MpTag)-sub$(Subsample).log
error = logs/01-baypass-init/$(MpTag)-sub$(Subsample).err
output = logs/01-baypass-init/$(MpTag)-sub$(Subsample).out

executable = 01-baypass-init.sh
arguments = $(MpTag) $(Subsample)

batch_name = "baypass-init"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
requirements = (HasCHTCStaging == true)

request_cpus = 8
request_memory = 24GB
request_disk = 50GB

#' `baypass_init_info.txt` (tag,subsample) is written by `_R/make-job-lists.R`.
queue MpTag,Subsample from baypass_init_info.txt
