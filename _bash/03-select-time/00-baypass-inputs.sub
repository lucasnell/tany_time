# baypass-inputs.sub

# prep files for baypass, one job per missing-data setting

container_image = file:///staging/l/lnell/tany_time.sif

log = logs/00-baypass-inputs/baypass-inputs_$(MpTag).log
error = logs/00-baypass-inputs/baypass-inputs_$(MpTag).err
output = logs/00-baypass-inputs/baypass-inputs_$(MpTag).out

executable = 00-baypass-inputs.sh
arguments = $(MpTag) $(MinProp)

batch_name = "baypass-inputs"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
requirements = (HasCHTCStaging == true)


## Copying outputs to ResearchDrive:
transfer_output_files = baypass-inputs_$(MpTag).tar.gz, baypass-inputs_$(MpTag)_3.tar.gz
output_destination = pelican://chtc.wisc.edu/researchdrive/arives/CHTC/baypass

request_cpus = 4
request_memory = 8GB
request_disk = 20GB

#' `baypass_inputs_info.txt` (tag,min_prop_pools) is written by
#' `_R/make-job-lists.R`.
queue MpTag,MinProp from baypass_inputs_info.txt
